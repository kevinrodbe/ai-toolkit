{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/.eslintcache", "{projectRoot}/tsconfig.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/coverage"]
    }
  },
  "targetDependencies": {
    "version": [
      {
        "projects": "dependencies",
        "target": "version"
      }
    ]
  },
  "tasksRunnerOptions": {
    "default": {
      "options": {
        "cacheableOperations": [
          "build",
          "lint:types",
          "lint:code",
          "lint:code:fix",
          "lint",
          "lint:fix",
          "test"
        ],
        "parallel": 5
      },
      "runner": "nx/tasks-runners/default"
    }
  },
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  }
}

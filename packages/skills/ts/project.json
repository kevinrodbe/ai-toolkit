{
	"$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/project-schema.json",
	"name": "skill-ts",
	"projectType": "library",
	"tags": ["type:library", "scope:package", "destination:feed"],
	"targets": {
		"github": {
			"executor": "@jscutlery/semver:github",
			"options": {
				"notes": "${notes}",
				"tag": "${tag}"
			}
		},
		"prerelease": {
			"executor": "@jscutlery/semver:version",
			"options": {
				"allowEmptyRelease": true,
				"noVerify": true,
				"preset": "conventional",
				"push": false,
				"releaseAs": "prerelease",
				"skipCommit": true,
				"skipProjectChangelog": true,
				"skipRootChangelog": true,
				"trackDeps": true
			}
		},
		"publish:root": {
			"executor": "nx:run-commands",
			"options": {
				"command": "pnpm -F @kevinrodbe/skill-ts publish --no-git-checks"
			}
		},
		"sync-skill-version": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node scripts/sync-skill-version.js --projectRoot {projectRoot}"
			}
		},
		"commit-and-tag": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node scripts/commit-and-tag.js --projectRoot {projectRoot} --projectName {projectName}"
			}
		},
		"version": {
			"executor": "@jscutlery/semver:version",
			"options": {
				"allowEmptyRelease": true,
				"noVerify": true,
				"postTargets": ["sync-skill-version", "version-push"],
				"preset": "conventional",
				"push": false,
				"skipCommit": true,
				"trackDeps": true
			}
		},
		"version-push": {
			"executor": "@jscutlery/semver:version",
			"options": {
				"allowEmptyRelease": true,
				"commitMessageFormat": "chore({projectName}): release version ${version} [skip ci]",
				"noVerify": true,
				"postTargets": ["skill-ts:github"],
				"preset": "conventional",
				"push": true,
				"skipCommit": false,
				"trackDeps": true
			}
		}
	}
}

{
  "name": "@kevinrodbe/root",
  "version": "1.0.0",
  "private": true,
  "description": "Skills and Agents",
  "keywords": [
    "system",
    "workspace"
  ],
  "license": "MIT",
  "author": "Rodbe",
  "type": "module",
  "scripts": {
    "add:agent": "nx generate @kevinrodbe/nx-plugin:agent-generator",
    "add:skill": "nx generate @kevinrodbe/nx-plugin:skill-generator",
    "build:all": "nx run-many --target=build",
    "lint:all": "nx run-many --target=lint",
    "lint:all:fix": "nx run-many --target=lint:fix",
    "prepare": "husky",
    "summary": "node scripts/summary.js",
    "test:unit": "nx run-many --target=test:unit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@commitlint/format": "21.1.0",
    "@commitlint/types": "21.1.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@jscutlery/semver": "^6.1.2",
    "@nx/devkit": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/plugin": "23.0.1",
    "@rodbe/eslint-config": "^1.4.0",
    "@rodbe/prettier-config": "^1.5.0",
    "@rodbe/tsconfig": "^1.5.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@swc/helpers": "~0.5.23",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^1.5.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "nx": "23.0.1",
    "prettier": "^3.9.1",
    "prettier-plugin-curly": "^0.4.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">= 22.0.0",
    "npm": ">= 10.0.0",
    "pnpm": ">= 10.0.0"
  },
  "engineStrict": true,
  "volta": {
    "node": "22.18.0",
    "pnpm": "10.12.1"
  }
}
